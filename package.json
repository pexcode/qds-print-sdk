{
  "name": "@pexcode/qds-print-sdk",
  "version": "3.5.3",
  "description": "SDK for printing shipping labels with QR codes , This is a TypeScript library published under an pexcode to help users and developers to use quickdeliverysystem print.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Mussab Muhaimeed",
  "license": "MIT",
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build": "tsc",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "push": "npm publish --access public"
  },
  "devDependencies": { 
    "@types/node": "^20.19.22",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "undici-types": "^5.1.0"
  },
  "dependencies": {
    "qz-tray": "^2.2.5"
  },
  "keywords": [
    "printing",
    "qds-print",
    "pexcode",
    "quickdeliverysystem",
    "shipping",
    "label"
  ]
}
